{
  "name": "notehub",
  "productName": "NoteHub",
  "version": "1.0.0",
  "description": "A beautiful, hackable note-taking app with notebook organization",
  "main": "main.js",
  "author": "Ty Ellis",
  "license": "MIT",
  "keywords": [
    "notes",
    "markdown",
    "electron",
    "productivity"
  ],
  "scripts": {
    "start": "electron .",
    "test": "node test.js && node --test tests/**/*.test.js",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.287",
    "codemirror": "^5.65.18",
    "mammoth": "^1.6.0",
    "mermaid": "^12.1.0",
    "pdf-parse": "^1.1.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.notehub.app",
    "productName": "NoteHub",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "preferences.html",
      "note-utils.js",
      "notebook-utils.js",
      "ai-providers.js",
      "markdown-utils.js",
      "context-menu.js",
      "find-replace.js",
      "styles/**/*",
      "fonts/**/*",
      "plugins/**/*",
      "node_modules/codemirror/**/*",
      "build/icon.png",
      "mermaid-render.js",
      "node_modules/mermaid/dist/mermaid.min.js"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "icon": "build/icons",
      "category": "Office"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "guid": "e56234f0-8779-52eb-ac3b-47dce4b43dd6",
      "uninstallDisplayName": "NoteHub"
    }
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true
  },
  "optionalDependencies": {
    "@github/copilot-sdk": "^1.0.16"
  }
}
